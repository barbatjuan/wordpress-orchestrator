# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Never commit site secrets or connector tokens
*.env
.env*
*connector*token*
secrets.*

# Auto-generated local tool state from `gentle-ai skill-registry refresh`; embeds absolute
# developer paths, so it is machine-local, not repo content.
.atl/

# Extracto local para revisar una tira suelta; se regenera desde index.html
.review-*.html

# Scripts de parcheo de un solo uso; nunca son parte del generador
_p*.php
_wire*.php
_ins*.php

# Local CodeGraph index; fully derived, machine-local
.codegraph/

# Blind-judge corpus: screenshots of DELIVERED CLIENT sites. corpus.md says so itself --
# "client work does not belong in this repository" -- but nothing enforced it, and this repo
# is public. The captures live on disk beside corpus.md for Judge A to read; they are never
# committed. corpus.md (the index) IS tracked; the frames are not.
/skills/blind-judges/references/corpus/*.jpg
/skills/blind-judges/references/corpus/*.png
